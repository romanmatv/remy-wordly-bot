# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Путь к файлу БД (создаётся автоматически вместе со структурой и словарями)
DB_PATH=data/wordly.db

# CSV-файлы для первичного заполнения словаря (пути относительно папки запуска)
CITY_CSV=city.csv
NOUNS_CSV=nouns.csv
OTHER_CSV=verbs.csv

# id пользователей Telegram (через запятую), которым доступны скрытые команды
# /seedbase и /delwordsall. Если пусто — доступны всем. Узнать свой id: @userinfobot
ADMIN_IDS=

# ---------------------------------------------------------------------------
# Подключение через MTProto proxy (необязательно).
# Если прокси задан, бот работает с Telegram напрямую по протоколу MTProto через этот прокси
# (обычный Bot API через MTProto proxy работать не умеет). Если не задан — обычный Bot API.
#
# Вариант 1: ссылка на прокси целиком (как её дают в Telegram)
# MTPROXY=tg://proxy?server=1.2.3.4&port=443&secret=ee0123456789abcdef...
# MTPROXY=https://t.me/proxy?server=1.2.3.4&port=443&secret=ee0123456789abcdef...
#
# Вариант 2: по отдельности
# MTPROXY_HOST=1.2.3.4
# MTPROXY_PORT=443
# MTPROXY_SECRET=ee0123456789abcdef...   # hex или base64; поддерживаются обычные, dd- и ee- (Fake TLS) секреты
#
# Для MTProto обязательно нужны api_id и api_hash: https://my.telegram.org → API development tools
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
#
# Файл сессии MTProto (по умолчанию — mtproto.session рядом с базой бота)
# MTPROTO_SESSION=data/mtproto.session
