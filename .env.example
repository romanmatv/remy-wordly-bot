# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Путь к файлу БД (создаётся автоматически вместе со структурой и словарями)
DB_PATH=data/wordly.db

# CSV-файлы для первичного заполнения словаря (пути относительно папки запуска)
CITY_CSV=city.csv
NOUNS_CSV=nouns.csv
OTHER_CSV=verbs.csv

# id пользователей Telegram (через запятую), которым доступны скрытые команды
# /seedbase и /delwordsall. Если пусто — доступны всем. Узнать свой id: @userinfobot
ADMIN_IDS=
